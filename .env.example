# Leave empty to run in demo mode with sample transcripts and notes.
SARVAM_API_KEY=

# Local dev uses SQLite. On Render, DATABASE_URL comes from the Postgres database.
# DATABASE_URL=sqlite:///./healthcare.db

# Public HTTPS URL that Sarvam can reach for the post-call webhook.
# Set automatically on Render (RENDER_EXTERNAL_URL). Locally, use an ngrok/cloudflared URL.
PUBLIC_BASE_URL=

# Sarvam Voice Agents (follow-up calls). "Call now" stays disabled until all of these are set.
SARVAM_AGENT_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
SARVAM_AGENT_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=

# Optional overrides
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_LANGUAGE=unknown
# SARVAM_LLM_MODEL=sarvam-105b
# MOCK_SARVAM=auto

# Gemma 4 via Gemini API, used as the evals judge
GEMINI_API_KEY=
# EVAL_MODEL=gemma-4-31b-it
